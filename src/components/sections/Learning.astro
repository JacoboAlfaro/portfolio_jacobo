---
import SectionHeading from '../ui/SectionHeading.astro';
import { learning } from '../../data/portfolio';
---

<section id="aprendiendo" class="section-anchor bg-navy py-20 text-white md:py-28">
  <div class="mx-auto w-full max-w-6xl px-5 md:px-8">
    <SectionHeading
      index="06 — Ahora"
      title="En qué estoy trabajando"
      text="Estoy profundizando en tecnologías que ya he utilizado en proyectos académicos y personales, especialmente Angular, TypeScript y desarrollo móvil. También estoy mejorando la forma en que estructuro aplicaciones y organizo su código."
      light
    />

    <ul class="mt-10 flex flex-wrap gap-3">
      {
        learning.map((item, index) => (
          <li
            data-reveal
            style={`transition-delay: ${index * 35}ms`}
            class="rounded-full border border-white/15 bg-white/8 px-4 py-2 text-sm text-white transition hover:-translate-y-0.5 hover:border-sky hover:text-sky"
          >
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
