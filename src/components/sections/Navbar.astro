---
import { nav, profile } from '../../data/portfolio';
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent"
>
  <div class="mx-auto flex h-18 w-full max-w-6xl items-center justify-between px-5 md:px-8">
    <a href="#inicio" class="flex items-center gap-3">
      <span class="brand-mark grid size-10 place-items-center rounded-xl text-sm font-extrabold tracking-wide">
        {profile.mark}
      </span>
      <span class="brand-name hidden text-sm font-semibold sm:block">Jacobo Alfaro</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Secciones">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link text-sm font-medium', item.href === '#inicio' && 'is-active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Activar modo oscuro"
        aria-pressed="false"
      >
        <svg class="icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <button
      id="menu-toggle"
      class="menu-toggle grid size-11 place-content-center gap-1.5 md:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <span class="block h-0.5 w-5"></span>
      <span class="block h-0.5 w-5"></span>
    </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden">
    <div>
      <nav class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-5 pb-5" aria-label="Secciones móvil">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'nav-link rounded-xl px-3 py-3 text-base font-medium',
                item.href === '#inicio' && 'is-active',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
