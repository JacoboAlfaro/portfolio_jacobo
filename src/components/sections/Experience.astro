---
import SectionHeading from '../ui/SectionHeading.astro';
import { experience } from '../../data/portfolio';
---

<section id="experiencia" class="section-anchor bg-mist py-20 md:py-28 dark:bg-dusk">
  <div class="mx-auto w-full max-w-6xl px-5 md:px-8">
    <SectionHeading
      index="04 — Práctica"
      title="Experiencia"
      text="He desarrollado aplicaciones web, móviles y APIs en proyectos técnicos y académicos."
    />

    <div class="mt-10 space-y-6">
      {
        experience.map((item) => (
          <article data-reveal class="rounded-3xl border border-navy/8 bg-surface p-6 md:p-8 dark:border-white/10 dark:bg-card">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
              <div>
                <h3 class="text-2xl font-semibold text-navy dark:text-foam">{item.title}</h3>
                <p class="mt-2 text-sm font-medium text-blue">{item.area}</p>
                {item.location && <p class="mt-1 text-sm text-ink dark:text-tide">{item.location}</p>}
              </div>
              {
                item.period && (
                  <p class="w-fit rounded-full bg-mist px-3 py-1 font-mono text-xs text-navy dark:bg-night dark:text-foam">
                    {item.period}
                  </p>
                )
              }
            </div>

            <p class="mt-6 max-w-3xl leading-7 text-ink dark:text-tide">{item.summary}</p>

            <ul class="mt-6 grid gap-2 sm:grid-cols-2">
              {item.activities.map((activity) => (
                <li class="flex gap-3 text-sm leading-6 text-ink dark:text-tide">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky" aria-hidden="true" />
                  {activity}
                </li>
              ))}
            </ul>

            {item.note && <p class="mt-6 text-sm leading-6 text-ink dark:text-tide">{item.note}</p>}

            <ul class="mt-6 flex flex-wrap gap-2">
              {item.technologies.map((tech) => (
                <li class="rounded-full border border-navy/10 px-3 py-1 text-xs font-medium text-navy dark:border-white/15 dark:text-foam">
                  {tech}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
