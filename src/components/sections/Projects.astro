---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectPreview from '../ui/ProjectPreview.astro';
import { projects } from '../../data/portfolio';
import { FaExternalLinkAlt, FaGithub } from 'react-icons/fa';

const featured = projects.filter((project) => project.featured);
const rest = projects.filter((project) => !project.featured);
---

<section id="proyectos" class="section-anchor bg-paper py-20 md:py-28 dark:bg-night">
  <div class="mx-auto w-full max-w-6xl px-5 md:px-8">
    <SectionHeading
      index="03 — Trabajo"
      title="Proyectos"
      text="Una selección de proyectos académicos y empresariales donde he puesto en práctica diferentes tecnologías y formas de desarrollar software."
    />

    <div class="mt-10 space-y-6">
      {
        featured.map((project) => (
          <article
            data-reveal
            class="project-card overflow-hidden rounded-3xl border border-navy/8 bg-surface transition hover:-translate-y-1 hover:border-sky/70 hover:shadow-[0_18px_40px_rgb(30_58_95/0.08)] lg:grid lg:grid-cols-2 dark:border-white/10 dark:bg-card dark:hover:shadow-none"
          >
            <ProjectPreview visual={project.visual} featured />
            <div class="flex flex-col p-6 md:p-8">
              <p class="text-xs font-semibold tracking-wide text-blue uppercase">{project.kind}</p>
              <h3 class="mt-2 text-2xl font-semibold text-navy dark:text-foam">{project.name}</h3>
              <p class="mt-3 text-sm leading-7 text-ink dark:text-tide md:text-base">{project.summary}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <li class="rounded-full bg-mist px-3 py-1 text-xs font-medium text-navy dark:bg-night dark:text-foam">{tech}</li>
                ))}
              </ul>
              {(project.codeUrl || project.demoUrl) && (
                <div class="mt-6 flex flex-wrap gap-3">
                  {project.codeUrl && (
                    <a
                      href={project.codeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex gap-2 min-h-11 items-center rounded-full bg-navy px-4 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-blue dark:bg-sky dark:text-night dark:hover:bg-foam"
                    >
                    <FaGithub size={16} /> <span>Ver código</span>
                    </a>
                  )}
                  {project.demoUrl && (
                    <a
                      href={project.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex gap-2 min-h-11 items-center rounded-full bg-navy px-4 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-blue dark:bg-sky dark:text-night dark:hover:bg-foam"
                    >
                      <FaExternalLinkAlt size={16} /> <span>Ver demo</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      {
        rest.map((project, index) => (
          <article
            data-reveal
            style={`transition-delay: ${index * 60}ms`}
            class="project-card flex flex-col overflow-hidden rounded-3xl border border-navy/8 bg-surface transition hover:-translate-y-1 hover:border-sky/70 hover:shadow-[0_18px_40px_rgb(30_58_95/0.08)] dark:border-white/10 dark:bg-card dark:hover:shadow-none"
          >
            <ProjectPreview visual={project.visual} />
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-semibold tracking-wide text-blue uppercase">{project.kind}</p>
              <h3 class="mt-2 text-xl font-semibold text-navy dark:text-foam">{project.name}</h3>
              <p class="mt-3 text-sm leading-7 text-ink dark:text-tide">{project.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <li class="rounded-full bg-mist px-3 py-1 text-xs font-medium text-navy dark:bg-night dark:text-foam">{tech}</li>
                ))}
              </ul>
              {(project.codeUrl || project.demoUrl) && (
                <div class="mt-6 flex flex-wrap gap-3">
                  {project.codeUrl && (
                    <a
                      href={project.codeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex gap-2 min-h-11 items-center rounded-full bg-navy px-4 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-blue dark:bg-sky dark:text-night dark:hover:bg-foam"
                    >
                        <FaGithub size={16} /> <span>Ver código</span>
                    </a>
                  )}
                  {project.demoUrl && (
                    <a
                      href={project.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex gap-2 min-h-11 items-center rounded-full border border-navy/15 px-4 text-sm font-semibold text-navy transition hover:-translate-y-0.5 hover:border-blue hover:text-blue dark:border-sky/40 dark:text-foam dark:hover:text-sky"
                    >
                      <FaExternalLinkAlt size={16} /> <span>Ver demo</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
