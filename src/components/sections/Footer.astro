---
import { nav, profile } from '../../data/portfolio';
import Image from 'astro/components/Image.astro';
import portrait from '../../assets/Img_Jacobo1.jpeg';
---

<footer class="bg-navy text-white dark:bg-[#08111c]">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-5 py-12 md:px-8 md:py-16">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="flex items-center gap-4">
        <Image src={portrait} alt={profile.name} width={100} height={100} class="size-12 shrink-0 rounded-full object-cover object-[center_22%] ring-2 ring-sky/80 sm:size-16" />
        <div>
            <p class="mt-2 text-2xl font-semibold">{profile.name}</p>
            <p class="text-sm text-white/75">{profile.role}</p>
        </div>
      </div>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Pie de página">
        {
          nav.map((item) => (
            <a href={item.href} class="text-sm text-white/80 transition hover:text-sky">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Jacobo Alfaro Hernández</p>
    </div>
  </div>
</footer>
